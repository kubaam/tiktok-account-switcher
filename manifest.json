{
  "manifest_version": 3,
  "name": "TikTok Account Switcher",
  "version": "1.0.0",
  "description": "Ukládá a přepíná TikTok účty výměnou cookies.",
  "permissions": ["cookies", "storage", "tabs", "scripting"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "host_permissions": ["https://*.tiktok.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "TikTok Account Switcher" }
}
